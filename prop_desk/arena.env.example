# Prop Desk Arena settings. Copy this file to "arena.env" (same folder) and edit it.
# Lines starting with # are comments. Restart the app after changing anything.

# --- Claude ---------------------------------------------------------------
# auto = API key if set, otherwise your Claude plan login, otherwise built-in rules
PROP_DESK_AI=auto
# claude-sonnet-5-5 uses roughly half the plan usage of claude-opus-5-5
PROP_DESK_MODEL=claude-opus-5-5
# Only if you use an API key instead of your plan login:
# ANTHROPIC_API_KEY=sk-ant-...

# --- The season -----------------------------------------------------------
# Each faction's starting money, and how long a season lasts (days).
PROP_DESK_CASH=100
PROP_DESK_SEASON_DAYS=30
# When to run a round, US-Eastern time, weekdays only. Each round uses about
# $2.20 of plan usage at API prices (mostly Iron Legion).
PROP_DESK_SCHEDULE_ET=09:45,15:30

# --- Risk (the same for every faction) ------------------------------------
PROP_DESK_RISK_PCT=1
PROP_DESK_MAX_POS_PCT=10
PROP_DESK_MAX_POSITIONS=8
PROP_DESK_MAX_DAILY_LOSS_PCT=3

# --- Optional -------------------------------------------------------------
# Trade alerts to Slack (an "incoming webhook" URL):
# PROP_DESK_ALERT_WEBHOOK=https://hooks.slack.com/services/...
# Let phones/laptops on your home network open the dashboard (see SETUP.md first):
# HOST=0.0.0.0
